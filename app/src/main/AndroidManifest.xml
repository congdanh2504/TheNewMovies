<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- allowBackup is off deliberately. The only local state is a re-fetchable TMDB cache, the
         selected tab, and the Supabase session, which supabase-kt keeps in SharedPreferences.
         Restoring that session onto another device would carry a signed-in identity with it.
         Turning backup back on requires android:dataExtractionRules that excludes those
         preferences; do not just flip this to true. -->
    <application
        android:name=".MoviesApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TheNewMovies">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TheNewMovies">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
